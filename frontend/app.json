{
  "expo": {
    "name": "CKD India",
    "slug": "ckd-kranti-dal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ckd",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.ckd.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Capture civic issue photos for reports",
        "NSPhotoLibraryUsageDescription": "Attach photos/videos to issue reports",
        "NSPhotoLibraryAddUsageDescription": "Save your membership card to gallery",
        "NSMicrophoneUsageDescription": "Record audio with issue videos"
      }
    },
    "android": {
      "package": "in.ckd.app",
      "versionCode": 9,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#3A1C71"
      },
      "edgeToEdgeEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            { "scheme": "https", "host": "app.ckdindia.com", "pathPrefix": "/" }
          ]
        },
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            { "scheme": "ckd" }
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#3A1C71"
        }
      ],
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach photos/videos to issue reports",
          "cameraPermission": "Capture civic issue photos for reports"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Save your membership card to gallery",
          "savePhotosPermission": "Save your membership card to gallery",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
